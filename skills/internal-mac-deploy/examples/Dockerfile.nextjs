# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile Multi-Stage Padrão Mac-811: Next.js (Standalone) + Prisma
# ==============================================================================

# --- TARGET: BASE ---
FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# Instala dependências de sistema necessárias (ex: openssl para o Prisma Engine)
RUN apt-get update && apt-get install -y \
    openssl \
    --no-install-recommends && rm -rf /var/lib/apt-get/lists/*

# --- TARGET: DEPENDENCIES ---
FROM base AS dependencies
COPY package.json package-lock.json ./
# IMPORTANTE: Copie o diretório do Prisma/ORM antes do npm ci para postinstall
COPY prisma ./prisma
RUN npm ci

# --- TARGET: BUILDER ---
FROM dependencies AS builder
# Declare ARGs de variáveis públicas necessárias no build
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY . .
# Cria pasta public se não existir, gera o cliente ORM e compila o projeto
RUN mkdir -p public && npx prisma generate && npm run build

# --- TARGET: MIGRATION ---
FROM dependencies AS migration
COPY prisma ./prisma
CMD ["npx", "prisma", "db", "push"]

# --- TARGET: CLI / TOOLS (Opcional - tarefas administrativas e seeds) ---
FROM dependencies AS cli
COPY prisma ./prisma
RUN npx prisma generate
COPY . .
ENTRYPOINT ["npm", "run"]
CMD ["db:status"]

# --- TARGET: RUNNER (Produção Final) ---
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Cria usuário não-root por segurança
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

# Copia apenas os artefatos standalone compilados
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Prepara diretórios de persistência de uploads com permissão correta
RUN mkdir -p public/uploads .data/private-uploads \
  && chown -R nextjs:nodejs public/uploads .data

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
